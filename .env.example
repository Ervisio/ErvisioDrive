NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-output-of-openssl-rand-base64-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MONGODB_URI=mongodb://127.0.0.1:27017/ervisiodrive
# Only used to seed the FIRST administrator when the whitelist is empty.
# Subsequently the database is authoritative, including for this email.
BOOTSTRAP_ADMIN_EMAIL=
STORAGE_DIR=./data/files
DRIVE_STORAGE_PATH=./data/files
STORAGE_QUOTA_GB=100
APP_PORT=3000
BIND_ADDRESS=127.0.0.1
UPLOAD_MAX_MB=100
# Only enable behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
