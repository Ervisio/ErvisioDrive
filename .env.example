NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-output-of-openssl-rand-base64-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MONGODB_URI=mongodb://127.0.0.1:27017/ervisiodrive
# Only used to seed the FIRST administrator when the whitelist is empty.
# Subsequently the database is authoritative, including for this email.
BOOTSTRAP_ADMIN_EMAIL=
STORAGE_DIR=./data/files
DRIVE_STORAGE_PATH=./data/files
# Workspace quota in GiB; 0 = unlimited. Administrators can override it in Settings.
STORAGE_QUOTA_GB=100
APP_PORT=3000
BIND_ADDRESS=127.0.0.1
# Per-file upload limit in MiB; 0 = unlimited. Overridable in Settings.
UPLOAD_MAX_MB=100
# 32-byte key (64 hex chars) that encrypts stored files at rest. setup generates
# it. Back it up: files cannot be read without it. Generate: openssl rand -hex 32
STORAGE_ENCRYPTION_KEY=
# Only enable behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
# Optional AWS Cognito User Pool OIDC sign-in.
COGNITO_ISSUER=
COGNITO_CLIENT_ID=
# Leave empty for a public app client using PKCE.
COGNITO_CLIENT_SECRET=
# Ervisio plugin mode: the drive opens its administration socket here so the
# Ervisio plugin can manage settings. Leave empty for a standalone install.
ERVISIO_SOCKET_DIR=
